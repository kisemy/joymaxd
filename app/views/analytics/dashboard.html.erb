<!-- app/views/analytics/dashboard.html.erb -->
<div class="container">
  <% if @projects.empty? %>
    <div class="alert alert-warning">No projects found</div>
  <% else %>
    <div class="row">
      <div class="col-md-6">
        <h3>Projects by Department</h3>
        <%= column_chart @by_department.transform_keys { |d| d.try(:name) || 'Unknown' } %>
      </div>
      
      <div class="col-md-6">
        <h3>Projects by Financial Year</h3>
        <%= bar_chart @by_financial_year.transform_keys { |fy| fy.try(:year) || 'Unknown' } %>
      </div>
    </div>
    
    <div class="row mt-4">
      <div class="col-md-6">
        <h3>Budget by Department</h3>
        <%= pie_chart @budget_by_department.transform_keys { |d| d.try(:name) || 'Unknown' } %>
      </div>
    </div>
  <% end %>
</div>
