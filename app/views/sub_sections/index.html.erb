
<!-- Skin configuration box -->
<!-- <%= render 'layouts/skinconfig' %> -->

    <!-- Wrapper-->
<div id="wrapper" class="<%= params[:controller] %>.<%= params[:action] %>">

        <!-- Navigation -->
        <%= render 'layouts/navigation' %>

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg <%= @extra_class %>">

            <!-- Page wrapper -->
            <%= render 'layouts/topnavbar' %>

            <!-- Main view  -->
            <!--<%= yield %>-->




<p id="notice"><%= notice %></p>

<h1>Sub Sections</h1>

<table>
  <thead>
    <tr>
      <th>Sub section code</th>
      <th>Sub section name</th>
      <th>Section_Code</th>
      <th>Section_name</th>
      <th>Department_Code</th>
      <th>Department_Name</th>
      <th>Complete projects</th>
      <th>Projects in progress</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @sub_sections.each do |sub_section| %>
      <tr>
        <td><%= sub_section.sub_section_code %></td>
        <td><%= sub_section.sub_section_name %></td>
        <td><%= sub_section.section_code %></td>
        <td><%= sub_section.section_name %></td>
        <td><%= sub_section.department_code %></td>
        <td><%= sub_section.department_name %></td>
        <td><%= sub_section.complete_projects %></td>
        <td><%= sub_section.projects_in_progress %></td>
        <td><%= link_to 'Show', sub_section %></td>
        <td><%= link_to 'Edit', edit_sub_section_path(sub_section) %></td>
        <td><%= link_to 'Destroy', sub_section, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Sub Section', new_sub_section_path %>

</div>
</div>
