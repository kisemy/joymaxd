<!-- Skin configuration box -->
<!-- <%= render 'layouts/skinconfig' %> -->

    <!-- Wrapper-->
<div id="wrapper" class="<%= params[:controller] %>.<%= params[:action] %>">

        <!-- Navigation -->
        <%= render 'layouts/navigation' %>

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg <%= @extra_class %>">

            <!-- Page wrapper -->
            <%= render 'layouts/topnavbar' %>

            <!-- Main view  -->
            
    <style>
.styled-textarea {
  width: 1000px;   /* Adjust width */
  
  resize: none;   /* Optional: Disable resizing */
}
/* Add this to make the card smaller */
.smaller-card {
  max-width: 1300px;  /* Adjust this value as needed */
  margin: 0 auto;    /* Centers the card */
}

</style>        

<%= form_with(model: sub_section, local: true) do |form| %>
  <% if sub_section.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(sub_section.errors.count, "error") %> prohibited this sub_section from being saved:</h2>

      <ul>
        <% sub_section.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
 <div class="card smaller-card">
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="formTabs" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" id="basic-tab" data-toggle="tab" href="#basic" role="tab">Basic Info</a>
        </li>
        
      </ul>
    </div>
    
    <div class="card-body tab-content" id="formTabsContent">
      <!-- Basic Tab -->
      <div class="tab-pane fade show active" id="basic" role="tabpanel">
       

 




  <div class="field">
    <%= form.label :sub_section_code %><br>
    <%= form.text_field :sub_section_code, class: 'styled-textarea'  %>
  </div>
<br>
  <div class="field">
    <%= form.label :sub_section_name %><br>
    <%= form.text_area :sub_section_name, class: 'styled-textarea'  %>
  </div>
<br>



  
  
    <div class="field">
  <%= form.select :department_name, 
      @departments.map { |d| [d.department_name, d.department_name, { 'data-code' => d.department_code }] }, 
      { include_blank: true }, 
      { class: 'styled-textarea department-select' } %>
</div>

 <div class="field">
  <%= form.label :department_code %><br>
  <%= form.text_field :department_code, class: 'styled-textarea department-code-field' %>
</div>




  
  
      <div class="field">
  <%= form.label :section_name %><br>
  <%= form.select :section_name, 
      @sections.map { |d| [d.section_name, d.section_name, { 'data-code' => d.section_code }] }, 
      { include_blank: true }, 
      { class: 'styled-textarea section-select' } %>
</div>


<div class="field">
    <%= form.label :section_code %><br>
    <%= form.text_field :section_code, class: 'styled-textarea section-code-field' %>
  </div> 
    
    
    
 
<br>



  


 
<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionSelect = document.querySelector('.section-select');
  const codeField = document.querySelector('.section-code-field');
  
  if (sectionSelect && codeField) {
    sectionSelect.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const sectionCode = selectedOption.getAttribute('data-code');
      codeField.value = sectionCode || '';
    });
  }
});

</script>




 
<script>
document.addEventListener('DOMContentLoaded', function() {
  const departmentSelect = document.querySelector('.department-select');
  const codeField = document.querySelector('.department-code-field');
  
  if (departmentSelect && codeField) {
    departmentSelect.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const departmentCode = selectedOption.getAttribute('data-code');
      codeField.value = departmentCode || '';
    });
  }
});

</script>
  
  
  
  
  
  

  <div class="field">
    <%= form.label :complete_projects %><br>
    <%= form.text_field :complete_projects, class: 'styled-textarea' %>
  </div>

  <div class="field">
    <%= form.label :projects_in_progress %><br>
    <%= form.text_field :projects_in_progress, class: 'styled-textarea' %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
  
</div>
  </div>  
  
<% end %>
</div>
</div>








 




