  </div>

  <div class="field">
    <%= form.label :department_name %>
    <%= form.text_area :department_name %>
  </div>

  <div class="field">
    <%= form.label :current_co_pno %>
    <%= form.text_field :current_co_pno %>
  </div>

  <div class="field">
    <%= form.label :current_co_telephone %>
    <%= form.text_field :current_co_telephone %>
  </div>

  <div class="field">
    <%= form.label :current_co_email %>
    <%= form.text_area :current_co_email %>
  </div>

  <div class="field">
    <%= form.label :general_programme_email %>
    <%= form.text_area :general_programme_email %>
  </div>

  <div class="field">
