<p id="notice"><%= notice %></p>

<h1>Programmes</h1>

<table>
  <thead>
    <tr>
      <th>Programme code</th>
      <th>Programme name</th>
      <th>Department code</th>
      <th>Department name</th>
      <th>Current co pno</th>
      <th>Current co telephone</th>
      <th>Current co email</th>
      <th>General programme email</th>
      <th>Complete projects</th>
      <th>Projects in progress</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @programmes.each do |programme| %>
      <tr>
        <td><%= programme.programme_code %></td>
        <td><%= programme.programme_name %></td>
        <td><%= programme.department_code %></td>
        <td><%= programme.department_name %></td>
        <td><%= programme.current_co_pno %></td>
        <td><%= programme.current_co_telephone %></td>
        <td><%= programme.current_co_email %></td>
        <td><%= programme.general_programme_email %></td>
        <td><%= programme.complete_projects %></td>
        <td><%= programme.projects_in_progress %></td>
        <td><%= link_to 'Show', programme %></td>
        <td><%= link_to 'Edit', edit_programme_path(programme) %></td>
        <td><%= link_to 'Destroy', programme, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Programme', new_programme_path %>
