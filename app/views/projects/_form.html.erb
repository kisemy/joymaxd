        };
        
        const map = new google.maps.Map(document.getElementById('project-map'), {
          zoom: 15,
          center: projectLocation
        });
        
        new google.maps.Marker({
          position: projectLocation,
          map: map,
          title: "<%= @project.project_name %>"
        });
      }
