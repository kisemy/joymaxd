<div class="field", class: 'styled-textarea'>
  <%= form.label :programme %><br>
  <%= form.select :programme_name, 
                  options_for_select([['Select Programme', '']]), 
                  {}, 
                  { id: 'project_programme', disabled: true } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const departmentSelect = document.querySelector('select.department-select');
  const programmeSelect = document.getElementById('project_programme');

  if (departmentSelect && programmeSelect) {
    departmentSelect.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const departmentCode = selectedOption ? selectedOption.getAttribute('data-code') : '';
      
      console.log('Department changed. Code:', departmentCode); // Debug log
      
      programmeSelect.disabled = !departmentCode;
      
      if (departmentCode) {
        fetchProgrammes(departmentCode);
      } else {
        resetProgrammeSelect();
      }
    });
  }

  function fetchProgrammes(departmentCode) {
    console.log('Fetching programmes for department:', departmentCode); // Debug log
    
    fetch(`/programmes?department_code=${encodeURIComponent(departmentCode)}&format=json`)
      .then(response => {
        console.log('Response status:', response.status); // Debug log
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
      })
      .then(data => {
        console.log('Received programme data:', data); // Debug log
        updateProgrammeSelect(data);
      })
      .catch(error => {
        console.error('Error fetching programmes:', error);
        resetProgrammeSelect();
      });
  }

  function updateProgrammeSelect(programmes) {
    console.log('Updating programme select with:', programmes); // Debug log
    
    // Clear existing options except the first one
    while (programmeSelect.options.length > 1) {
      programmeSelect.remove(1);
    }
    
    if (programmes && programmes.length > 0) {
      programmes.forEach(programme => {
        const option = new Option(programme.programme_name, programme.programme_name);
        programmeSelect.add(option);
      });
      programmeSelect.disabled = false;
    } else {
      programmeSelect.disabled = true;
    }
  }

  function resetProgrammeSelect() {
    console.log('Resetting programme select'); // Debug log
    while (programmeSelect.options.length > 1) {
      programmeSelect.remove(1);
    }
    programmeSelect.disabled = true;
  }
});
</script>















