<!-- app/views/projects/show.html.erb -->
<h3>Project Gantt Chart </h3>

<br>
<br>
<br>
<div class="gantt-container">
  <div id="gantt_chart" style="width: 100%; min-height: 600px;"></div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize the chart only if the container exists
  if (document.getElementById('gantt_chart')) {
    initializeGanttChart();
  }
});

function initializeGanttChart() {
  google.charts.load('current', {
    packages: ['gantt'],
    callback: drawGanttChart
  });
}

function drawGanttChart() {
  const data = new google.visualization.DataTable();
  data.addColumn('string', 'Task ID');
  data.addColumn('string', 'Task Name');
  data.addColumn('date', 'Start Date');
  data.addColumn('date', 'End Date');
  data.addColumn('number', 'Duration');
  data.addColumn('number', 'Percent Complete');
  data.addColumn('string', 'Dependencies');

  // Add your actual task data
  <% @project_tasks.each do |task| %>
    data.addRow([
      '<%= task.task_no %>',
      '<%= j(task.task_description) %>',
      new Date('<%= task.planned_start_date %>'),
      new Date('<%= task.planned_end_date %>'),
      null,
      <%= task.percentage_coverage.to_f || 0 %>,
      '<%= task.p_tsk_01 %>'
    ]);
  <% end %>

  const options = {
    height: <%= @chart_height %>,
    gantt: {
      trackHeight: 50,
      criticalPathEnabled: false,
      arrow: {
        angle: 60,
        width: 2,
        color: '#ccc'
      }
    }
  };

  const chart = new google.visualization.Gantt(document.getElementById('gantt_chart'));
  
  // Handle window resizing
  window.addEventListener('resize', function() {
    chart.draw(data, options);
  });
  
  chart.draw(data, options);
}
</script>


