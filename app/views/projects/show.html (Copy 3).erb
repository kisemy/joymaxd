<script>
const options = {
  width: '100%', // Use full container width
  height: <%= @chart_height %>,
  chartArea: {
    width: '90%', // Leave some margin for labels
    height: '80%'
  },
  gantt: {
    barHeight: 24, // Slightly taller bars
    trackHeight: 36, // More space between tracks
    // Remove fixed padding to allow expansion
    viewport: {
      visible: {
        units: 'months', // Adjust based on your time scale

    count: <%= @time_span_months %>

        
       
        
      }
    }
  }
};


options.gantt.barStyle = {
  fill: function(task) {
    return getStatusColor(task.getValue(5), task.getValue(8));
  },
  stroke: 'none',
  rx: 3, // Rounded corners
  ry: 3
};

options.gantt.barLabelStyle = {
  color: '#fff',
  fontSize: '11px',
  bold: true
};




const options = {
  // ... other options ...
  gantt: {
    labelStyle: {
      fontSize: 14,  // Increased from default 11
      fontName: 'Arial',
      color: '#333',
      bold: true
    },
    barLabelStyle: {
      fontSize: 12,  // Text inside bars
      color: '#fff',
      bold: true
    }
  }
};

options.chartArea = {
  left: 250,  // Increased from typical 150-200
  width: '855%',
  height: '85%'
};

</script>

<script>
function drawGanttChart() {
  const container = document.getElementById('gantt_chart');
  const containerWidth = container.offsetWidth;
  
  const data = new google.visualization.DataTable();
  // ... your data setup ...

  const options = {
    width: containerWidth,
    height: <%= @chart_height %>,
    chartArea: {
      left: 280,  // More space for larger labels
      width: '85%',
      height: '85%'
    },
    gantt: {
      labelStyle: {
        fontSize: 14,
        fontName: 'Arial',
        color: '#333',
        bold: true
      },
      barLabelStyle: {
        fontSize: 12,
        color: '#fff',
        bold: true
      },
      barHeight: 28,  // Slightly taller bars
      trackHeight: 40  // More vertical space
    }
  };

  const chart = new google.visualization.Gantt(container);
  chart.draw(data, options);
  
  // Handle window resize
  window.addEventListener('resize', function() {
    options.width = container.offsetWidth;
    options.gantt.labelStyle.fontSize = calculateFontSize(container.offsetWidth);
    chart.draw(data, options);
  });
}
</script>

<style>
  /* Ensure labels are visible and properly sized */
  .google-visualization-gantt-label {
    font-size: 14px !important;
    font-weight: bold !important;
    white-space: nowrap !important;
  }
  
  /* Better contrast for bar labels */
  .google-visualization-gantt-barlabel {
