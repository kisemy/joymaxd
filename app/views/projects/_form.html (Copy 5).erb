<script>
document.addEventListener('DOMContentLoaded', function() {
  const departmentSelect = document.querySelector('.department-select');
  const codeField = document.querySelector('.department-code-field');
  
  if (departmentSelect && codeField) {
    departmentSelect.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const departmentCode = selectedOption.getAttribute('data-code');
      codeField.value = departmentCode || '';
    });
  }
});

</script>



<div class="field">
  <%= form.label :programme_name, "Programme" %><br>
  <%= form.select :programme_name, 
      @sections.map { |p| [p.section_name, p.section_name, { 'data-department' => p.department_code }] }, 
      { include_blank: true }, 
      { class: 'programme-select' } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const departmentSelect = document.querySelector('.department-select');
  const programmeSelect = document.querySelector('.programme-select');
  
  if (departmentSelect && programmeSelect) {
    departmentSelect.addEventListener('change', function() {
      const selectedDept = this.value;
      const options = programmeSelect.querySelectorAll('option');
      
      options.forEach(option => {
        if (option.value === "" || option.dataset.department === selectedDept) {
          option.style.display = '';
        } else {
          option.style.display = 'none';
        }
      });
      
      // Reset programme selection when department changes
      programmeSelect.value = '';
    });
  }
});

</script>











