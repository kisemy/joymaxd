 <div class="field">
    <%= form.label :ward %>
    <%= form.select :ward, 
                    options_for_select([['Select Ward', '']] + @wards.map { |w| [w.ward_name, w.ward_name] }, @project.ward),
                    {},
                    { id: 'project_ward' } %>
  </div>



<script>
document.addEventListener('DOMContentLoaded', function() {
  const subCountySelect = document.getElementById('project_sub_county_code');
  const wardSelect = document.getElementById('project_ward');

  if (subCountySelect && wardSelect) {
    subCountySelect.addEventListener('change', function() {
      const subCountyCode = this.value;
      
      if (subCountyCode) {
        fetch(`/projects/get_wards?sub_county_code=${subCountyCode}`)
          .then(response => response.json())
          .then(wards => {
            wardSelect.innerHTML = '';
            
            // Add default blank option
            wardSelect.add(new Option('Select Ward', ''));
            
            // Add ward options
            wards.forEach(ward => {
              wardSelect.add(new Option(ward.name, ward.name));
            });
            
            // Preselect if editing existing project
            if ('<%= @project.ward %>') {
              wardSelect.value = '<%= @project.ward %>';
            }
          });
      } else {
        // Clear wards if no sub-county selected
        wardSelect.innerHTML = '';
        wardSelect.add(new Option('Select Ward', ''));
      }
    });
    
    // Trigger change event if sub_county is already selected (edit form)
    if (subCountySelect.value) {
      subCountySelect.dispatchEvent(new Event('change'));
    }
  }
});
</script>




