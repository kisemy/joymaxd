<div class="field">
  <%= form.label :ward %>
  <%= form.select :ward, 
                  options_for_select([['Select Ward', '']]), 
                  {}, 
                  { id: 'project_ward', disabled: true } %>
</div>

<script>
// app/javascript/packs/application.js (or similar)
document.addEventListener('DOMContentLoaded', function() {
  const subCountySelect = document.querySelector('.sub_county-select');
  const wardSelect = document.getElementById('project_ward');
  const subCountyCodeField = document.querySelector('.sub_county-code-field');

  if (subCountySelect) {
    subCountySelect.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const subCountyCode = selectedOption ? selectedOption.getAttribute('data-code') : '';
      
      subCountyCodeField.value = subCountyCode || '';
      wardSelect.disabled = !subCountyCode;
      
      if (subCountyCode) {
        fetchWards(subCountyCode);
      } else {
        resetWardSelect();
      }
    });
  }

  function fetchWards(subCountyCode) {
    fetch(`/wards?sub_county_code=${encodeURIComponent(subCountyCode)}&format=json`)
      .then(response => response.json())
      .then(data => {
        updateWardSelect(data);
      })
      .catch(error => {
        console.error('Error fetching wards:', error);
        resetWardSelect();
      });
  }

  function updateWardSelect(wards) {
    wardSelect.innerHTML = '<option value="">Select Ward</option>';
    wards.forEach(ward => {
      const option = document.createElement('option');
      option.value = ward.ward_name;
      option.textContent = ward.ward_name;
      wardSelect.appendChild(option);
    });
  }

  function resetWardSelect() {
    wardSelect.innerHTML = '<option value="">Select Ward</option>';
    wardSelect.disabled = true;
  }
});
</script>
  
   
  
  

 

   
      
 
