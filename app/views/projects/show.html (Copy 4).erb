<!-- app/views/projects/show.html.erb -->
<h3>Project Gantt Chart </h3>

<br>
<br>
<br>


<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<div class="gantt-container">
  <div id="gantt_chart" style="width: 100%; min-height: 600px;"></div>
</div>



<script>
document.addEventListener('turbo:load', function() {
  if (document.getElementById('gantt_chart')) {
    google.charts.load('current', {
      packages: ['gantt'],
      callback: drawGanttChart
    });
  }
});

function drawGanttChart() {
  try {
    console.log('Initializing Gantt chart...');
    
    const data = new google.visualization.DataTable();
    data.addColumn('string', 'Task ID');
    data.addColumn('string', 'Task Name');
    data.addColumn('date', 'Start Date');
    data.addColumn('date', 'End Date');
    data.addColumn('number', 'Duration');
    data.addColumn('number', 'Percent Complete');
    data.addColumn('string', 'Dependencies');

    // Debug: Log all tasks being processed
    <% @project_tasks.each_with_index do |task, index| %>
      console.group('Task #<%= index %>');
      console.log('Task ID:', '<%= task.task_no %>');
      console.log('Description:', '<%= j(task.task_description) %>');
      
      const startDate = new Date('<%= task.planned_start_date %>');
      const endDate = new Date('<%= task.planned_end_date %>');
      
      console.log('Start Date:', '<%= task.planned_start_date %>', 'Parsed:', startDate);
      console.log('End Date:', '<%= task.planned_end_date %>', 'Parsed:', endDate);
      
      if (isNaN(startDate.getTime())) {
        console.error('⚠️ INVALID START DATE');
      }
      if (isNaN(endDate.getTime())) {
        console.error('⚠️ INVALID END DATE');
      }
      
      console.log('Percentage:', <%= task.percentage_coverage.to_f || 0 %>);
      console.log('Dependencies:', '<%= task.p_tsk_01 %>');
      console.groupEnd();
      
      data.addRow([
        '<%= task.task_no %>',
        '<%= j(task.task_description) %>',
        startDate,
        endDate,
        null,
        <%= task.percentage_coverage.to_f || 0 %>,
        '<%= task.p_tsk_01 %>'
      ]);
    <% end %>

    console.log('Data table prepared with', data.getNumberOfRows(), 'rows');
    console.table(data.getDataTable().toJSON()); // View the complete data structure

    // Basic options with fallbacks
    const options = {
      height: <%= @chart_height || 600 %>,
      width: '100%',
      gantt: {
        trackHeight: 40,
        barHeight: 20,
        labelStyle: {
          fontSize: 14,
          color: '#333'
        },
        barLabelStyle: {
          fontSize: 12,
          color: '#fff'
        }
      }
    };

    const chart = new google.visualization.Gantt(document.getElementById('gantt_chart'));
    chart.draw(data, options);
    console.log('Chart rendered successfully');

  } catch (error) {
    console.error('Chart rendering failed:', error);
    document.getElementById('gantt_chart').innerHTML = `
      <div class="alert alert-danger">
        <h4>Chart Rendering Error</h4>
        <p>${error.message}</p>
        <p>Check console for detailed error logs</p>
      </div>
    `;
  }
}
</script>










<br>
<div class="gantt-container">
  <div class="chart-debug">
    <h4>Data Summary</h4>
    <p>Total Tasks: <%= @project_tasks.count %></p>
    <p>First Task Start: <%= @project_tasks.first&.planned_start_date %></p>
    <p>Last Task End: <%= @project_tasks.last&.planned_end_date %></p>
  </div>
  
  <div id="gantt_chart" style="width: 100%; min-height: 600px; border: 2px dashed #ccc;">
    <!-- Chart will render here -->
  </div>
  
  <div class="data-debug" style="margin-top: 20px; padding: 10px; background: #f8f9fa;">
