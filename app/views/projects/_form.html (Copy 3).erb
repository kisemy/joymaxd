<!-- Optional: Display a map using Google Maps or similar -->
<div id="map" style="height: 400px; width: 100%;"></div>

<script>
  function initMap() {
    var location = {lat: <%= @project.latitude %>, lng: <%= @project.longitude %>};
    var map = new google.maps.Map(document.getElementById('map'), {
      zoom: 15,
      center: location
    });
    var marker = new google.maps.Marker({
      position: location,
      map: map
    });
  }
</script>
<script async defer
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCoQqrzSpIfk68tFwuTFfJwwOb5uBOXRaQ&callback=initMap">
