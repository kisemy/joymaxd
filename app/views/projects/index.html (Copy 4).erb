<script>
/* Table styling for auto-fit content */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.elegant-table {
  width: 100%;
  table-layout: auto;
  border-collapse: collapse;
}

.elegant-table th {
  min-width: 80px; /* Default min-width */
  padding: 8px 12px;
  text-align: left;
  background-color: #333;
  color: white;
  position: sticky;
  top: 0;
}

/* Specific column widths */
.elegant-table th:nth-child(1) { min-width: 80px; } /* Project no */
.elegant-table th:nth-child(2) { min-width: 120px; } /* Project name */
.elegant-table th:nth-child(3) { min-width: 100px; } /* Financial year */
.elegant-table th:nth-child(4) { min-width: 150px; } /* Brief description */
.elegant-table th:nth-child(5) { min-width: 120px; } /* Department */
/* Add more nth-child rules for other columns as needed */

.elegant-table td {
  padding: 8px 12px;
  border-bottom: 1px solid #ddd;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.elegant-table td.description-cell {
  white-space: normal; /* For cells that need to wrap */
}

.elegant-table tr:hover {
  background-color: #f5f5f5;
}

</script>

