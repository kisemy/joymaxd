<script>
document.addEventListener('turbolinks:load', function() {
  $('.datatable').DataTable({
    dom: 'Blfrtip',
    buttons: [
      'copy', 'csv', 'excel', 'pdf', 'print'
    ],
    initComplete: function() {
      // Add individual search inputs for each column
      this.api().columns().every(function() {
        var column = this;
        var title = $(column.header()).text().trim();
        
        // Skip the action columns (Show/Edit/Destroy)
        if (title === '') return;
        
        // Create input element
        var input = $('<input type="text" class="form-control form-control-sm" placeholder="Search '+title+'" />')
          .appendTo($(column.header()))
          .on('keyup change clear', function() {
            if (column.search() !== this.value) {
              column.search(this.value).draw();
            }
          });
      });
    }
  });
});

</script>

<script>
document.addEventListener('turbolinks:load', function() {
  $('.datatable').DataTable({
    dom: 'Blfrtip',
    buttons: [
      'copy', 'csv', 'excel', 'pdf', 'print'
    ],
    initComplete: function() {
      this.api().columns().every(function(index) {
        var column = this;
        var title = $(column.header()).text().trim();
        
        // Skip action columns
        if (title === '') return;
        
        // For specific columns, create dropdowns
        if (['Department', 'Financial Year', 'Project Status', 'Sub County Name', 'Ward'].includes(title)) {
          var select = $('<select class="form-control form-control-sm"><option value="">All '+title+'</option></select>')
            .appendTo($(column.header()))
            .on('change', function() {
              var val = $.fn.dataTable.util.escapeRegex($(this).val());
              column.search(val ? '^'+val+'$' : '', true, false).draw();
            });
            
          column.data().unique().sort().each(function(d) {
            select.append('<option value="'+d+'">'+d+'</option>');
          });
        } 
        // For numeric columns
        else if (['Budgeted', 'Actual'].includes(title)) {
          var div = $('<div class="numeric-search"></div>').appendTo($(column.header()));
          
          $('<input type="number" class="form-control form-control-sm" placeholder="Min" />')
            .appendTo(div)
            .on('keyup change', function() {
              column.data().indexOf('min') === -1 ? 
                column.data().push({type: 'min', value: this.value}) : 
                column.data()[column.data().indexOf('min')].value = this.value;
              filterNumericColumn(column);
            });
            
          $('<input type="number" class="form-control form-control-sm" placeholder="Max" />')
            .appendTo(div)
            .on('keyup change', function() {
              column.data().indexOf('max') === -1 ? 
                column.data().push({type: 'max', value: this.value}) : 
                column.data()[column.data().indexOf('max')].value = this.value;
              filterNumericColumn(column);
            });
        }
        // For date columns
        else if (['Start Date', 'End Date'].includes(title)) {
          $('<input type="date" class="form-control form-control-sm" placeholder="Filter '+title+'" />')
            .appendTo($(column.header()))
            .on('change', function() {
              if (column.search() !== this.value) {
                column.search(this.value).draw();
              }
            });
        }
        // For all other columns - text search
        else {
          $('<input type="text" class="form-control form-control-sm" placeholder="Search '+title+'" />')
            .appendTo($(column.header()))
            .on('keyup change clear', function() {
              if (column.search() !== this.value) {
                column.search(this.value).draw();
              }
            });
        }
      });
    }
  });
  
  function filterNumericColumn(column) {
    var min = column.data().find(d => d.type === 'min')?.value || -Infinity;
    var max = column.data().find(d => d.type === 'max')?.value || Infinity;
    
    column.search(function(idx, data, node) {
      var num = parseFloat(data.replace(/[^\d.-]/g, '')) || 0;
      return num >= min && num <= max ? '' : 'none';
    }).draw();
  }
});
</script>




