<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get all relevant elements
  const destinationTypeSelect = document.getElementById('destination-type-select');
  const internalFields = document.getElementById('internal-request-fields');
  const customerFields = document.getElementById('customer-fields');
  const internalSupplySelect = document.querySelector('.internal-supply-select');
  const customerSelect = document.querySelector('.customer-select');
  const destinationNameField = document.querySelector('#store_request_destination_name');
  const destinationCodeField = document.querySelector('#store_request_destination_code');

  // Function to toggle fields based on destination type
  function toggleDestinationFields() {
    if (!destinationTypeSelect) return;

    const selectedType = destinationTypeSelect.value;
    
    if (selectedType === 'internal') {
      internalFields.style.display = 'block';
      customerFields.style.display = 'none';
      // Clear customer selection when switching to internal
      if (customerSelect) customerSelect.value = '';
    } 
    else if (selectedType === 'customer') {
      internalFields.style.display = 'none';
      customerFields.style.display = 'block';
      // Clear internal selection when switching to customer
      if (internalSupplySelect) internalSupplySelect.value = '';
    } 
    else {
      internalFields.style.display = 'none';
      customerFields.style.display = 'none';
      // Clear both selections when no type is selected
      if (internalSupplySelect) internalSupplySelect.value = '';
      if (customerSelect) customerSelect.value = '';
    }
    
    // Clear destination fields when type changes
    destinationNameField.value = '';
    destinationCodeField.value = '';
  }

  // Update destination fields when internal supply is selected
  if (internalSupplySelect) {
    internalSupplySelect.addEventListener('change', function() {
      if (this.value) {
        const selectedOption = this.options[this.selectedIndex];
        destinationNameField.value = selectedOption.text;
        destinationCodeField.value = this.value;
      } else {
        destinationNameField.value = '';
        destinationCodeField.value = '';
      }
    });
  }

  // Update destination fields when customer is selected
  if (customerSelect) {
    customerSelect.addEventListener('change', function() {
      if (this.value) {
        const selectedOption = this.options[this.selectedIndex];
        destinationNameField.value = selectedOption.text;
        destinationCodeField.value = this.value;
      } else {
        destinationNameField.value = '';
        destinationCodeField.value = '';
      }
    });
  }

  // Initialize fields on page load
  toggleDestinationFields();
  
  // Set up event listener for destination type changes
  if (destinationTypeSelect) {
    destinationTypeSelect.addEventListener('change', toggleDestinationFields);
    
    // Also initialize destination fields if values are already selected
    if (destinationTypeSelect.value === 'internal' && internalSupplySelect && internalSupplySelect.value) {
      const selectedOption = internalSupplySelect.options[internalSupplySelect.selectedIndex];
      destinationNameField.value = selectedOption.text;
      destinationCodeField.value = internalSupplySelect.value;
    } 
    else if (destinationTypeSelect.value === 'customer' && customerSelect && customerSelect.value) {
      const selectedOption = customerSelect.options[customerSelect.selectedIndex];
      destinationNameField.value = selectedOption.text;
      destinationCodeField.value = customerSelect.value;
    }
  }
});
</script>

  
 
