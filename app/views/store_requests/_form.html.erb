<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
  $(document).ready(function() {
    // Add new stock line
    $('#add_store_requestline').click(function() {
      const template = $('#store_requestlines_template').html(); // Fixed ID
      const newRow = $(template.replace(/NEW_RECORD/g, new Date().getTime()));
      $('#store_requestlines tbody').append(newRow);
    });

    // Handle item selection change
    $(document).on('change', '.item_select', function() {
      const selectedOption = $(this).find('option:selected');
      const row = $(this).closest('tr');
      
      // Populate fields from data attributes
      row.find('.product_description').val(selectedOption.data('description'));
      row.find('.unit_price').val(selectedOption.data('unit-price'));
      row.find('.inventory_account').val(selectedOption.data('inventory-account'));
      
      // Trigger amount calculation
      row.find('.quantity').trigger('input');
    });

    // Calculate amount when quantity or price changes
    $(document).on('input', '.quantity, .unit_price', function() {
      const row = $(this).closest('tr');
      const quantity = parseFloat(row.find('.quantity').val()) || 0;
      const unitPrice = parseFloat(row.find('.unit_price').val()) || 0;
      const amount = quantity * unitPrice;
      row.find('.amount').val(amount.toFixed(2));
    });

    // Remove stock line
    $(document).on('click', '.remove_stockline', function() {
      $(this).closest('tr').remove();
    });
  });
</script>
  
 








