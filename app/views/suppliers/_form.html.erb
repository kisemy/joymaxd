<style>
form-group {
  position: relative;
  margin-bottom: 1.5rem;
  width: 100%;
  max-width: 400px;
}

:root {
  --primary-color: #4361ee;
  --error-color: #ef233c;
  --success-color: #4cc9f0;
  --text-color: #2b2d42;
  --light-gray: #f8f9fa;
  --medium-gray: #e9ecef;
  --dark-gray: #6c757d;
  --border-radius: 8px;
  --transition-speed: 0.3s;
}

.form-group {
  position: relative;
  margin-bottom: 1.5rem;
  width: 100%;
  max-width: 400px;
}

.modern-input {
  width: 100%;
  padding: 1rem;
  font-size: 1rem;
  border: 1px solid var(--medium-gray);
  border-radius: var(--border-radius);
  background-color: white;
  transition: all var(--transition-speed) ease;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.modern-input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
}

.floating-label {
  position: absolute;
  top: 1rem;
  left: 1rem;
  color: var(--dark-gray);
  font-size: 1rem;
  pointer-events: none;
  transition: all var(--transition-speed) ease;
  background: white;
  padding: 0 0.25rem;
  transform-origin: left center;
}

.modern-input:focus + .floating-label,
.modern-input:not(:placeholder-shown) + .floating-label {
  transform: translateY(-1.75rem) scale(0.85);
  color: var(--primary-color);
  font-weight: 500;
}

.input-border {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 2px;
  background-color: var(--primary-color);
  transition: all var(--transition-speed) ease;
  transform: translateX(-50%);
}

.modern-input:focus ~ .input-border {
  width: 100%;
}

.input-hint {
  font-size: 0.75rem;
  color: var(--dark-gray);
  margin-top: 0.5rem;
  padding: 0 1rem;
}

/* Error state */
.modern-input.error {
  border-color: var(--error-color);
}

.modern-input.error:focus {
  box-shadow: 0 0 0 3px rgba(239, 35, 60, 0.2);
}

.modern-input.error ~ .floating-label {
  color: var(--error-color);
}

.modern-input.error ~ .input-border {
  background-color: var(--error-color);
}

/* Success state */
.modern-input.success {
  border-color: var(--success-color);
}

.modern-input.success:focus {
  box-shadow: 0 0 0 3px rgba(76, 201, 240, 0.2);
}

.modern-input.success ~ .floating-label {
  color: var(--success-color);
}

.modern-input.success ~ .input-border {
  background-color: var(--success-color);
}

/* Password toggle */
.toggle-password {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--dark-gray);
  cursor: pointer;
  padding: 0.5rem;
}

.toggle-password:hover {
  color: var(--primary-color);
}

/* Disabled state */
.modern-input:disabled {
  background-color: var(--light-gray);
  cursor: not-allowed;
}

/* With icon */
.form-group.has-icon .modern-input {
  padding-left: 3rem;
}

.input-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--dark-gray);
  pointer-events: none;
}





</style>


