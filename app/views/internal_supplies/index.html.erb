            <!-- Main view  -->
            <!--<%= yield %>-->



<p id="notice"><%= notice %></p>

<h1>Internal Supplies</h1>

<table>
  <thead>
    <tr>
      <th>Supplier name</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @internal_supplies.each do |internal_supply| %>
      <tr>
        <td><%= internal_supply.supplier_name %></td>
        <td><%= link_to 'Show', internal_supply %></td>
        <td><%= link_to 'Edit', edit_internal_supply_path(internal_supply) %></td>
        <td><%= link_to 'Destroy', internal_supply, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Internal Supply', new_internal_supply_path %>

</div>
</div>
