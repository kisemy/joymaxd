


<!-- Skin configuration box -->
<!-- <%= render 'layouts/skinconfig' %> -->

    <!-- Wrapper-->
<div id="wrapper" class="<%= params[:controller] %>.<%= params[:action] %>">

        <!-- Navigation -->
        <%= render 'layouts/navigation' %>

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg <%= @extra_class %>">

            <!-- Page wrapper -->
            <%= render 'layouts/topnavbar' %>

            <!-- Main view  -->
            <!--<%= yield %>-->



<p id="notice"><%= notice %></p>

<h4>Item Ledgers</h4>

<table>
  <thead>
    <tr>
      <th>Item no</th>
      <th>Posting date</th>
      <th>Document no</th>
      <th>Source no</th>
      <th>Description</th>
      <th>Quantity</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @item_ledgers.each do |item_ledger| %>
      <tr>
        <td><%= item_ledger.item_no %></td>
        <td><%= item_ledger.posting_date %></td>
        <td><%= item_ledger.document_no %></td>
        <td><%= item_ledger.source_no %></td>
        <td><%= item_ledger.description %></td>
        <td><%= item_ledger.quantity %></td>
        <td><%= link_to 'Show', item_ledger %></td>
        <td><%= link_to 'Edit', edit_item_ledger_path(item_ledger) %></td>
        <td><%= link_to 'Destroy', item_ledger, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Item Ledger', new_item_ledger_path %>

</div>
</div>
