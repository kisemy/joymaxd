  background: rgba(255, 255, 255, 0.15);
}

.submenu .menu-item a:before {
  content: '';
  display: inline-block;
  width: 6px; /* Slightly larger dot */
  height: 6px;
  background: white;
  border-radius: 50%;
  margin-right: 12px; /* More spacing */
  position: relative;
  top: -2px;
}

.menu-item.has-children.open .dropdown-icon {
  transform: rotate(180deg);
}

/* Page Content */
.page-content {
  flex: 1;
  padding: 20px;
  background: #f5f7fa;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .sidebar {
    width: 70px; /* Slightly wider for mobile */
    flex: 0 0 70px;
  }
  
  .sidebar-brand, 
  .menu-link > span {
    display: none;
  }
  
  .menu-link {
    justify-content: center;
    padding: 16px 0; /* More padding for mobile */
    font-size: 1.1rem; /* Larger font for mobile */
  }
  
  .menu-link i:first-child {
    margin-right: 0;
    font-size: 1.4rem; /* Larger icons for mobile */
  }
  
  .dropdown-icon {
    display: none;
  }
  
  .submenu {
    position: absolute;
    left: 70px;
    width: 220px; /* Wider submenu for mobile */
    top: 0;
    display: none;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3); /* Stronger shadow */
  }
  
  .submenu.show {
    display: block;
    max-height: unset;
  }
  
  .submenu .menu-item a {
    padding: 14px 20px 14px 25px; /* Adjusted padding */
    font-size: 1.05rem; /* Slightly larger for mobile */
  }
}
</style>



