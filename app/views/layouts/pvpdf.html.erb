<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice</title>
  <style>
    /* Basic reset */
  

    /* Invoice container */
    .invoice-container {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      background-color: white;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      border-radius: 8px;
    }

    /* Table styles */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    th, td {
      padding: 8px;
      border: 1px solid #ddd;
    }

    th {
      background-color: #007bff;
      color: white;
      font-weight: bold;
    }

    tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    /* Footer styles */
    .footer {
      text-align: center;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      color: #666;
    }
  </style>
  
  <style>
  
  @media print {
  .containerpv {
    display: flex;
    flex-direction: row;
  }
  .col-md-6 {
    width: 50%;
    float: left;
  }
  .content {
    page-break-inside: avoid;
  }
  .card-form {
    page-break-inside: avoid;
  }
  .page__container {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  .card {
    border: none;
    box-shadow: none;
  }
  .navbar-light {
    display: none; /* Hide the header if not needed in print */
  }
}
  
  </style>
  
  <div class="px-3">

            <div class="d-flex justify-content-center flex-column text-center my-5 navbar-light">
              <class="navbar-brand d-flex flex-column m-0" style="min-width: 0">
                  <%= image_tag "safaricomlogo.png", :size => "300x100" %>
                
              </a>
            <strong><h1>PAYMENT VOUCHER</h1></strong>
            </div>
            
  
  
  <div style="max-width: 800px; margin: 20px auto; padding: 20px; background-color: white; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); border-radius: 8px;">
  <h1 style="color: #007bff; text-align: center;">Payment #<%= @payment.id %></h1>
  <p style="color: #666; text-align: center;">Generated on: <%= Time.current.strftime("%B %d, %Y") %></p>
</div>
  
  
  
  
</head>
<body>
  <div class="invoice-container">
    <%= yield %>
  </div>
</body>
</html>
