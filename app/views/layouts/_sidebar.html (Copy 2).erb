<style>
.sidebar {
  background: linear-gradient(135deg, #2c3e50 0%, #1a1a2e 100%);
  width: 250px;
  height: 100vh;
  position: fixed;
  left: 0;
  top: 0;
  padding: 20px 0;
  box-shadow: 2px 0 15px rgba(0, 0, 0, 0.1);
  z-index: 1000;
  overflow-y: auto;
  
  .sidebar-brand {
    color: white;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0 20px 20px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 20px;
  }
  
  .menu {
    list-style: none;
    padding: 0;
    margin: 0;
    
    .menu-item {
      position: relative;
      
      > a {
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 12px 20px;
        transition: all 0.3s ease;
        font-weight: 300;
        
        &:hover {
          background: rgba(255, 255, 255, 0.1);
        }
        
        i {
          margin-right: 10px;
          font-size: 1.1rem;
        }
      }
      
      &.active > a {
        background: rgba(255, 255, 255, 0.1);
        font-weight: 500;
      }
      
      // Chevron icon for items with children
      &.has-children > a:after {
        content: '\f078';
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
        margin-left: auto;
        font-size: 0.8rem;
        transition: transform 0.3s ease;
      }
      
      &.open > a:after {
        transform: rotate(180deg);
      }
    }
    
    // Submenu styling
    .submenu {
      list-style: none;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      background: rgba(0, 0, 0, 0.2);
      
      &.show {
        max-height: 500px;
      }
      
      .menu-item a {
        padding-left: 50px;
        font-size: 0.9rem;
        
        &:before {
          content: '';
          display: inline-block;
          width: 5px;
          height: 5px;
          background: white;
          border-radius: 50%;
          margin-right: 10px;
        }
      }
    }
  }
}

// Mobile responsiveness
@media (max-width: 768px) {
  .sidebar {
    width: 60px;
    overflow: hidden;
    
    .sidebar-brand, .menu-item > a > span {
      display: none;
    }
    
    .menu-item > a {
      justify-content: center;
      
      i {
        margin-right: 0;
        font-size: 1.3rem;
      }
    }
    
    .submenu {
      position: absolute;
      left: 60px;
      width: 200px;
      top: 0;
      display: none;
      
      &.show {
        display: block;
        max-height: unset;
      }
    }
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  initSidebar();
});

// Also initialize on Turbolinks page change
document.addEventListener('turbolinks:load', function() {
  initSidebar();
});

function initSidebar() {
  const menuItems = document.querySelectorAll('.menu-item.has-children');
  const sidebar = document.querySelector('.sidebar');
  let hoverTimer;
  
  // Click functionality
  menuItems.forEach(item => {
    const link = item.querySelector('> a');
    
    link.addEventListener('click', function(e) {
      // Don't prevent default if it's a real link
      if (this.getAttribute('href') === '#') {
        e.preventDefault();
      }
      toggleSubmenu(item);
    });
  });
  
  // Hover functionality for desktop
  if (window.innerWidth > 768) {
    menuItems.forEach(item => {
      item.addEventListener('mouseenter', function() {
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => {
          openSubmenu(this);
        }, 200);
      });
      
      item.addEventListener('mouseleave', function() {
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => {
          if (!this.classList.contains('open-by-click')) {
            closeSubmenu(this);
          }
        }, 300);
      });
    });
    
    // Keep submenu open when hovering over it
    document.querySelectorAll('.submenu').forEach(submenu => {
      submenu.addEventListener('mouseenter', function() {
        clearTimeout(hoverTimer);
      });
      
      submenu.addEventListener('mouseleave', function() {
        const parentItem = this.closest('.menu-item');
        if (!parentItem.classList.contains('open-by-click')) {
          closeSubmenu(parentItem);
        }
      });
    });
  }
  
  // Close when clicking outside
  document.addEventListener('click', function(e) {
    if (!sidebar.contains(e.target)) {
      closeAllSubmenus();
    }
  });
}

function toggleSubmenu(menuItem) {
  if (menuItem.classList.contains('open')) {
    closeSubmenu(menuItem);
    menuItem.classList.remove('open-by-click');
  } else {
    openSubmenu(menuItem);
    menuItem.classList.add('open-by-click');
  }
}

function openSubmenu(menuItem) {
  // Close others first
  closeAllSubmenus();
  
  menuItem.classList.add('open');
  const submenu = menuItem.querySelector('.submenu');
  submenu.classList.add('show');
}

function closeSubmenu(menuItem) {
  menuItem.classList.remove('open');
  const submenu = menuItem.querySelector('.submenu');
  submenu.classList.remove('show');
}

function closeAllSubmenus() {
  document.querySelectorAll('.menu-item.has-children').forEach(item => {
    item.classList.remove('open', 'open-by-click');
    item.querySelector('.submenu').classList.remove('show');
  });
}



document.addEventListener('DOMContentLoaded', function() {
  initSidebar();
});

document.addEventListener('turbolinks:load', function() {
  initSidebar();
});

function initSidebar() {
  const menuItems = document.querySelectorAll('.menu-item.has-children');
  const sidebar = document.querySelector('.sidebar');
  let hoverTimers = {};
  const isMobile = window.innerWidth <= 768;

  // Initialize each menu item
  menuItems.forEach(item => {
    const link = item.querySelector('> a');
    const submenu = item.querySelector('.submenu');
    const itemId = item.textContent.trim() || Math.random().toString(36).substr(2, 9);
    
    // Click functionality
    link.addEventListener('click', function(e) {
      if (link.getAttribute('href') === '#') {
        e.preventDefault();
      }
      if (isMobile) {
        toggleSubmenu(item);
      } else {
        // On desktop, click makes the menu sticky
        item.classList.toggle('force-open');
        if (item.classList.contains('force-open')) {
          openSubmenu(item);
        } else {
          closeSubmenu(item);
        }
      }
    });

    // Hover functionality for desktop only
    if (!isMobile) {
      item.addEventListener('mouseenter', function() {
        clearTimeout(hoverTimers[itemId]);
        hoverTimers[itemId] = setTimeout(() => {
          if (!item.classList.contains('force-open')) {
            openSubmenu(item);
          }
        }, 200);
      });

      item.addEventListener('mouseleave', function() {
        clearTimeout(hoverTimers[itemId]);
        hoverTimers[itemId] = setTimeout(() => {
          if (!item.classList.contains('force-open')) {
            closeSubmenu(item);
          }
        }, 300);
      });

      // Keep submenu open when hovering over it
      submenu.addEventListener('mouseenter', function() {
        clearTimeout(hoverTimers[itemId]);
      });

      submenu.addEventListener('mouseleave', function() {
        hoverTimers[itemId] = setTimeout(() => {
          if (!item.classList.contains('force-open')) {
            closeSubmenu(item);
          }
        }, 300);
      });
    }
  });

  // Close all menus when clicking outside
  document.addEventListener('click', function(e) {
    if (!sidebar.contains(e.target)) {
      closeAllSubmenus();
    }
  });

  // Handle window resize
  window.addEventListener('resize', function() {
    if (window.innerWidth <= 768 && !isMobile) {
      closeAllSubmenus();
    }
  });
}

function toggleSubmenu(menuItem) {
  if (menuItem.classList.contains('open')) {
    closeSubmenu(menuItem);
  } else {
    openSubmenu(menuItem);
  }
}

function openSubmenu(menuItem) {
  // Close other menus first unless on mobile
  if (window.innerWidth > 768) {
    document.querySelectorAll('.menu-item.has-children').forEach(item => {
      if (item !== menuItem && !item.classList.contains('force-open')) {
        closeSubmenu(item);
      }
    });
  }
  
  menuItem.classList.add('open');
  menuItem.querySelector('.submenu').classList.add('show');
}

function closeSubmenu(menuItem) {
  if (!menuItem.classList.contains('force-open')) {
    menuItem.classList.remove('open');
    menuItem.querySelector('.submenu').classList.remove('show');
  }
}

function closeAllSubmenus() {
  document.querySelectorAll('.menu-item.has-children').forEach(item => {
    item.classList.remove('open', 'force-open');
    item.querySelector('.submenu').classList.remove('show');
  });
}







</script>

<div class="sidebar">
  <div class="sidebar-brand">
    <%= Rails.application.class.module_parent_name %>
  </div>
  
  <ul class="menu">
    <li class="menu-item <%= 'active' if current_page?(projects_path) %>">
      <%= link_to projects_path do %>
        <i class="fas fa-tachometer-alt"></i>
        <span>Dashboard</span>
      <% end %>
    </li>
    
    <li class="menu-item has-children <%= 'active' if controller_name == 'departments' %>">
      <%= link_to '#' do %>
        <i class="fas fa-box-open"></i>
        <span>Departments</span>
      <% end %>
      <ul class="submenu">
        <li class="menu-item <%= 'active' if current_page?(departments_path) %>">
          <%= link_to departments_path do %>
            <span>All Departments</span>
          <% end %>
        </li>
        <li class="menu-item <%= 'active' if current_page?(new_department_path) %>">
          <%= link_to new_department_path do %>
            <span>Add New</span>
          <% end %>
        </li>
      </ul>
    </li>
    
    <!-- Add more menu items as needed -->
  </ul>
</div>


</nav>
</div>






