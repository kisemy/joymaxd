<p id="notice"><%= notice %></p>

<h1>Salesquote Lines</h1>

<table>
  <thead>
    <tr>
      <th>Charge type</th>
      <th>Item no</th>
      <th>Description</th>
      <th>Quantity</th>
      <th>Unit of measure</th>
      <th>Unit price</th>
      <th>Amount</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @salesquote_lines.each do |salesquote_line| %>
      <tr>
        <td><%= salesquote_line.charge_type %></td>
        <td><%= salesquote_line.item_no %></td>
        <td><%= salesquote_line.description %></td>
        <td><%= salesquote_line.quantity %></td>
        <td><%= salesquote_line.unit_of_measure %></td>
        <td><%= salesquote_line.unit_price %></td>
        <td><%= salesquote_line.amount %></td>
        <td><%= link_to 'Show', salesquote_line %></td>
        <td><%= link_to 'Edit', edit_salesquote_line_path(salesquote_line) %></td>
        <td><%= link_to 'Destroy', salesquote_line, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Salesquote Line', new_salesquote_line_path %>
