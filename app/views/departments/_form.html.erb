    <!-- Wrapper-->
<div id="wrapper" class="<%= params[:controller] %>.<%= params[:action] %>">

        <!-- Navigation -->
        <%= render 'layouts/navigation' %>

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg <%= @extra_class %>">

            <!-- Page wrapper -->
            <%= render 'layouts/topnavbar' %>

            <!-- Main view  -->






<style>
.styled-textarea {
  width: 1000px;   /* Adjust width */
  
  resize: none;   /* Optional: Disable resizing */
}
/* Add this to make the card smaller */
.smaller-card {
  max-width: 1300px;  /* Adjust this value as needed */
  margin: 0 auto;    /* Centers the card */
}

</style>


<%= form_with(model: department, local: true) do |form| %>
  <% if department.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(department.errors.count, "error") %> prohibited this department from being saved:</h2>

      <ul>
        <% department.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="card smaller-card">
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="formTabs" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" id="basic-tab" data-toggle="tab" href="#basic" role="tab">Basic Info</a>
        </li>
        
      </ul>
    </div>
    
    <div class="card-body tab-content" id="formTabsContent">
      <!-- Basic Tab -->
      <div class="tab-pane fade show active" id="basic" role="tabpanel">
       

  <div class="field"><br>
    <%= form.label :department_code %><br>
    <%= form.text_field :department_code, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :department_name %><br>
    <%= form.text_area :department_name, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :current_CEC_p_no %><br>
    <%= form.text_field :current_CEC_p_no, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :current_CEC_name %><br>
    <%= form.text_area :current_CEC_name, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :current_CEC_telephone %><br>
    <%= form.text_field :current_CEC_telephone, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :current_CEC_email %><br>
    <%= form.text_area :current_CEC_email, class: 'styled-textarea' %>
  </div>
<br>
  <div class="field">
    <%= form.label :general_dept_email %><br>
    <%= form.text_area :general_dept_email, class: 'styled-textarea' %>
  </div>
  
   </div>  
      
      </div>
      
  
  
  

  <div class="actions">
    <%= form.submit %>
  </div>
  <br>
  <br>
<% end %>

 </div>
      </div>



 



