<p id="notice"><%= notice %></p>

<h1>Salesorder Lines</h1>

<table>
  <thead>
    <tr>
      <th>Charge type</th>
      <th>Item no</th>
      <th>Description</th>
      <th>Quantity</th>
      <th>Unit of measure</th>
      <th>Unit price</th>
      <th>Amount</th>
      <th>Order No</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @salesorder_lines.each do |salesorder_line| %>
      <tr>
        <td><%= salesorder_line.charge_type %></td>
        <td><%= salesorder_line.item_no %></td>
        <td><%= salesorder_line.description %></td>
        <td><%= salesorder_line.quantity %></td>
        <td><%= salesorder_line.unit_of_measure %></td>
        <td><%= salesorder_line.unit_price %></td>
        <td><%= salesorder_line.amount %></td>
        <td><%= salesorder_line.order_no %></td>
        <td><%= link_to 'Show', salesorder_line %></td>
        <td><%= link_to 'Edit', edit_salesorder_line_path(salesorder_line) %></td>
        <td><%= link_to 'Destroy', salesorder_line, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Salesorder Line', new_salesorder_line_path %>
