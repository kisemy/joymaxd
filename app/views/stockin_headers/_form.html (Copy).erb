 <script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const supplierSelect = document.getElementById('stockin_header_supplier_name');
  console.log('Supplier Select Element:', supplierSelect); // Debugging

  if (!supplierSelect) {
    console.error('ERROR: Could not find #stockin_header_supplier_name');
    return;
  }

  supplierSelect.addEventListener('change', function() {
    console.log('Supplier changed to:', this.value); // Debugging
    const supplierName = this.value;
    const url = '/stockin_headers/get_supplier_details';

    if (supplierName) {
      fetch(`${url}?supplier_name=${encodeURIComponent(supplierName)}`)
        .then(response => response.json())
        .then(data => {
          console.log('API Response:', data); // Debugging
          document.getElementById('stockin_header_supplier_no').value = data.supplier_no || '';
          document.getElementById('stockin_header_telephone').value = data.telephone || '';
          document.getElementById('stockin_header_email').value = data.email || '';
          document.getElementById('stockin_header_address').value = data.address || '';
        })
        .catch(error => console.error('Fetch Error:', error));
    } else {
      ['supplier_no', 'telephone', 'email', 'address'].forEach(field => {
        document.getElementById(`stockin_header_${field}`).value = '';
      });
    }
  });
});
</script>
 
</script>
































