<p id="notice"><%= notice %></p>

<h1>Store Requestlines</h1>

<table>
  <thead>
    <tr>
      <th>Code</th>
      <th>Product description</th>
      <th>Quantity</th>
      <th>Unit cost</th>
      <th>Amount</th>
      <th>Received</th>
      <th>Expiry date</th>
      <th>Batch no</th>
      <th>Stock balance</th>
      <th>Destination code</th>
      <th>Destination name</th>
      <th>Store request</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @store_requestlines.each do |store_requestline| %>
      <tr>
        <td><%= store_requestline.code %></td>
        <td><%= store_requestline.product_description %></td>
        <td><%= store_requestline.quantity %></td>
        <td><%= store_requestline.unit_cost %></td>
        <td><%= store_requestline.amount %></td>
        <td><%= store_requestline.received %></td>
        <td><%= store_requestline.expiry_date %></td>
        <td><%= store_requestline.batch_no %></td>
        <td><%= store_requestline.stock_balance %></td>
        <td><%= store_requestline.destination_code %></td>
        <td><%= store_requestline.destination_name %></td>
        <td><%= store_requestline.store_request_id %></td>
        <td><%= link_to 'Show', store_requestline %></td>
        <td><%= link_to 'Edit', edit_store_requestline_path(store_requestline) %></td>
        <td><%= link_to 'Destroy', store_requestline, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Store Requestline', new_store_requestline_path %>
