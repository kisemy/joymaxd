
<!-- Skin configuration box -->
<!-- <%= render 'layouts/skinconfig' %> -->

    <!-- Wrapper-->
<div id="wrapper" class="<%= params[:controller] %>.<%= params[:action] %>">

        <!-- Navigation -->
        <%= render 'layouts/navigation' %>

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg <%= @extra_class %>">

            <!-- Page wrapper -->
            <%= render 'layouts/topnavbar' %>

            <!-- Main view  -->
            <!--<%= yield %>-->






<p id="notice"><%= notice %></p>

<h1>Villages</h1>

<table>
  <thead>
    <tr>
      <th>Village code</th>
      <th>Village name</th>
      <th>Sub county code</th>
      <th>Sub county name</th>
      <th>Ward code</th>
      <th>Ward name</th>
      <th>Village admin pno</th>
      <th>Village admin name</th>
      <th>Village admin telephone</th>
      <th>Village admin email</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @villages.each do |village| %>
      <tr>
        <td><%= village.village_code %></td>
        <td><%= village.village_name %></td>
        <td><%= village.sub_county_code %></td>
        <td><%= village.sub_county_name %></td>
        <td><%= village.ward_code %></td>
        <td><%= village.ward_name %></td>
        <td><%= village.village_admin_pno %></td>
        <td><%= village.village_admin_name %></td>
        <td><%= village.village_admin_telephone %></td>
        <td><%= village.village_admin_email %></td>
        <td><%= link_to 'Show', village %></td>
        <td><%= link_to 'Edit', edit_village_path(village) %></td>
        <td><%= link_to 'Destroy', village, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Village', new_village_path %>

</div>
</div>
