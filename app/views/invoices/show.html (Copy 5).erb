<script>
  document.getElementById('pdf-download').addEventListener('click', function(event) {
    event.preventDefault(); // Prevent default link behavior
    window.open(this.href, '_blank'); // Open PDF in a new tab
  });
</script>
  

 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice</title>
  <%= stylesheet_link_tag 'invoices', media: 'all' %>
  
   <style>
    /* General styles */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    /* Header styles */
    .header {
      background-color: #007bff; /* Blue color */
      color: white;
      padding: 5px;
      text-align: center;
    }

    /* Footer styles */
    .footer {
      background-color: #007bff; /* Blue color */
      color: white;
      padding: 20px;
      text-align: center;
      position: fixed;
      bottom: 0;
      width: 100%;
    }

    /* Content styles */
    .content {
      padding: 20px;
    }

    /* Table styles */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    table, th, td {
      border: 1px solid #ddd;
    }

    th, td {
      padding: 10px;
      text-align: left;
    }

    th {
      background-color: #f2f2f2;
    }
  </style>
  
  
  
  
  
  
</head>
<body>
  <div class="a4-container">
    <!-- Header with Logo -->
    <div class="header">
      <%= image_tag 'safaricomlogo.png', alt: 'Company Logo', class: 'logo' %>
       <%= wicked_pdf_image_tag 'safaricomlogo.png' %> <!-- Include logo -->
      <h1>Invoice</h1>
    </div>
 <div class="print-button">
    <button onclick="printInvoice()">Print to PDF</button>
  </div>

    <!-- Invoice Details -->
    <div class="row">
      <p><strong>Invoice No:</strong> <%= @invoice.id %></p>
      <p><strong>Due Date:</strong> </p>
    </div>

    <!-- Billing and Shipping Information -->
    <div class="row">
      <div class="column">
        <h4>Billing Address</h4>
         <p><strong><%= @invoice.customer_name %></strong></p>
      </div>
     
    </div>


  <p><strong>Date:</strong> <%= @invoice.date %></p>

  
  <br>
  <br>

  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @invoice.invoice_lines.each do |line| %>
        <tr>
          <td><%= line.description %></td>
          <td><%= line.quantity %></td>
          <td><%= line.unit_price %></td>
          <td><%= line.amount %></td>
          
        </tr>
      <% end %>
    </tbody>
  </table>
<br>
<br>

  <script>
    function printInvoice() {
      window.print(); // Trigger the browser's print functionality
    }
  </script>
    <!-- Footer -->
    <div class="footer1">
      <p>Thank you for your business!</p>
    </div>
  </div>
</body>
</html>
