<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice</title>

</head>
<body>
  <!-- Header -->
  <div class="header">
    <h1>Invoice #<%= @invoice.id %></h1>
    <p>Generated on: <%= Time.current.strftime("%B %d, %Y") %></p>
  </div>

  <!-- Content -->
  <div class="content">
    <h2>Bill To:</h2>
    <p><%= @invoice.customer_name %></p>
    <p><%= @invoice.address %></p>


    <h2>Invoice Details:</h2>
    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th>Quantity</th>
          <th>Unit Price</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% @invoice.invoice_lines.each do |line| %>
        <tr>
          <td><%= line.description %></td>
          <td><%= line.quantity %></td>
          <td><%= line.unit_price %></td>
          <td><%= line.amount %></td>
          
        </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align: right;"><strong>Grand Total:</strong></td>
          
        </tr>
      </tfoot>
    </table>
  </div>
   
  
  
  

  <!-- Footer -->
  <div class="footer">
    <p>Thank you for your business! | <%= link_to "Visit Our Website", "https://www.example.com", style: "color: white;" %></p>
  </div>
  
  
    <script>
    function printInvoice() {
      window.print(); // Trigger the browser's print functionality
    }
  </script>
  
  
</body>
</html>
