


  

 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice</title>
  <%= stylesheet_link_tag 'invoices', media: 'all' %>
   <%= wicked_pdf_stylesheet_link_tag "application" %> <!-- Include CSS -->
  <%= wicked_pdf_javascript_include_tag "application" %> <!-- Include JS (if needed
 <style>
  body { font-family: Arial, sans-serif; }
  h1 { color: #333; }
  p { margin: 5px 0; }
  .header { text-align: center; }
</style>
  
  
  
</head>
<body>
  <div class="a4-container">
    <!-- Header with Logo -->
    <div class="header">
      <%= image_tag 'safaricomlogo.png', alt: 'Company Logo', class: 'logo' %>
       <%= wicked_pdf_image_tag 'logo.png' %> <!-- Include logo -->
      <h1>Invoice</h1>
    </div>

    <!-- Invoice Details -->
    <div class="row">
      <p><strong>Invoice No:</strong> <%= @invoice.id %></p>
      <p><strong>Due Date:</strong> </p>
    </div>

    <!-- Billing and Shipping Information -->
    <div class="row">
      <div class="column">
        <h4>Billing Address</h4>
         <p><strong><%= @invoice.customer_name %></strong></p>
      </div>
     
    </div>


  <p><strong>Date:</strong> <%= @invoice.date %></p>

  
  <br>
  <br>

  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @invoice.invoice_lines.each do |line| %>
        <tr>
          <td><%= line.description %></td>
          <td><%= line.quantity %></td>
          <td><%= line.unit_price %></td>
          <td><%= line.amount %></td>
          
        </tr>
      <% end %>
    </tbody>
  </table>
<br>
<br>
    <!-- Footer -->
    <div class="footer1">
      <p>Thank you for your business!</p>
    </div>
  </div>
</body>
</html>
