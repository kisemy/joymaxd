  </div>
    </div>
     <div class="card-footer text-end">
      <%= f.submit 'Save', class: 'btn btn-primary' %>
    </div>
   
  </div>
  
  
  
  <% end %>
  <!-- Other form fields and submit button -->


<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
    // Set up event listeners for account selection changes
    setupAccountAutofill('sales');
    setupAccountAutofill('cost');
    setupAccountAutofill('purchase');

    function setupAccountAutofill(prefix) {
      const select = document.querySelector(`[data-target="${prefix}-account-select"]`);
      const field = document.querySelector(`[data-target="${prefix}-account-field"]`);

      if (select && field) {
        select.addEventListener('change', function() {
          const selectedName = this.value;
          if (selectedName) {
            // In a real app, you would fetch the account number via AJAX
            // This is a simplified version assuming the data is preloaded
            const accounts = <%= @chart_of_accounts.to_json.html_safe %>;
            const selectedAccount = accounts.find(account => account.name === selectedName);
            if (selectedAccount) {
              field.value = selectedAccount.no;
            }
          } else {
            field.value = '';
          }
        });
      }
    }
  });
	
     
        
        
        
        
        
        
        
       

 
  <% end %>

